<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8" />
  <title>Selfroles verwalten</title>
  <link rel="stylesheet" href="/css/style.css" />
  <!--Skript ausführen, welches überprüft was voreingestellt ist-->
  <%- include('partials/darkmode-script') %>
</head>

<body data-sel-names="<%= JSON.stringify(allSelNames) %>" data-sel-men-obj="<%= JSON.stringify(Array.from(allSelMenObj)) %>">
  <%- include('partials/sidebar', {guildIds: guildIds}) %>
  <div class="rl-sel-main main">
    <% if (error) { %>
    <div class="error-box">
      <strong>Fehler:</strong>
      <%= error %>
    </div>
    <% } %>
    <h1 class="header-rl-sel page-header">Selfroles verwalten</h1>
    <form action="/role-select" method="GET">
      <label for="serverId">Wähle einen Server:</label>
      <select name="serverId" id="serverId" onchange="this.form.submit()">
        <option value="" disabled <%= !selectedServerId ? 'selected' : '' %>>-- Bitte wählen --</option>
        <% servers.forEach(function(server, index) { %>
        <% 
        const isSelected = selectedServerId 
          ? server.id === selectedServerId 
          : index === 0; 
      %>
        <option value="<%= server.id %>" <%= isSelected ? 'selected' : '' %>><%= server.name %></option>
        <% }); %>
      </select>
    </form>
    <button id="rl-sel-addBtn" class="rol-sel-add-btn">Hinzufügen</button>
    <% allSelMenObj.forEach(function(selMenObj) {  %>
    <hr>
    <details>
      <summary><%= selMenObj.name %></summary>
      <div class="rl-sel-rlmen-ctnt-div">
        <div class="rl-sel-rlmen-btn-div">
          <button class="rol-sel-upd-btn" data-name="<%= selMenObj.name %>">Update</button>
          <form class="rl-sel-rlmen-upd-form" action="/role-select/send" method="POST">
            <input type="hidden" name="selMenName" value="<%= selMenObj.name %>" />
            <input type="hidden" name="serverId" value="<%= selectedServerId %>" />
            <label for="rl-sel-rlmen-snd-btn">Rollenauswahl auf Discord senden/updaten:</label>
            <button type="submit" class="rl-sel-rlmen-snd-btn">Senden</button>
          </form>
          <form class="rl-sel-rlmen-upd-form" action="/role-select/delete" method="POST" onsubmit="return confirm('Möchtest du diese Rollenauswahl wirklich entgültig löschen?');">
            <input type="hidden" name="selMenName" value="<%= selMenObj.name %>" />
            <input type="hidden" name="serverId" value="<%= selectedServerId %>" />
            <label for="rl-sel-rlmen-dlt-btn">Rollenauswahl komplett löschen:</label>
            <button type="submit" class="rl-sel-rlmen-dlt-btn">Löschen</button>
          </form>
        </div>
        <div class="rl-sel-rlmen-desc-div">
          <p>Rollenauswahl Text: <%= selMenObj.description %></p>
        </div>
        <div class="rl-sel-rlmen-multi-div">
          <label for="selMen-multi-disabled-chkbx">Mehrfachauswahl erlaubt?</label>
          <input id="selMen-multi-disabled-chkbx" type="checkbox" disabled <%= selMenObj.multiSelect ? 'checked' : '' %> />
        </div>
        <div class="rl-sel-rlmen-list-div">
          <p>Rollen:</p>
          <ul>
            <% selMenObj.roleNames.forEach((rolename) => { %>
            <li><%= rolename %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </details>
    <% }); %>
    <!--pop up for insert-->
    <div id="rl-sel-popUpModal" class="rl-sel-popup-div">
      <div class="rl-sel-popup-ctnt-div">
        <h2>Füge eine Selfroles Auswahl hinzu</h2>
        <form action="/role-select/add" method="POST" class="rol-sel-add-btn-form">
          <input type="hidden" name="serverId" value="<%= selectedServerId %>" />
          <label for="selName">Name/Bezeichnung des Selfroles Auswahl</label>
          <input type="text" id="selName" name="selName" required />
          <span id="error-msg" style="color: red; display: none;">Dieser Name existiert bereits!</span>
          <br />
          <label for="selDesc">Text welcher in der Nachricht der Selfrole Auswahl steht</label>
          <input type="text" id="selDesc" name="selDesc" required />
          <br />
          <label for="selMulti">Dürfen mehrere Rollen zugewiesen werden?</label>
          <input type="checkbox" id="selMulti" name="selMulti" />
          <br />
          <% rollen.forEach(function(role) { %>
          <br />
          <input id="role-<%= role.id %>" type="checkbox" name="roles" class="rl-sel-ckbx" value="<%= role.id %>">
          <label for="role-<%= role.id %>"><%= role.name %></label>
          <% }); %>
          <br />
          <button type="submit" id="rl-sel-submitAddBtn" class="rl-sel-add-btn" disabled>Hinzufügen</button>
        </form>
      </div>
    </div>
    <!--pop up for update-->
    <div id="rl-sel-updatePopUpModal" class="rl-sel-popup-div">
      <div class="rl-sel-popup-ctnt-div">
        <h2>Update eine Selfroles Auswahl</h2>
        <p id="selMenObj-name"></p>
        <label for="update-selMulti">Mehrfachauswahl erlaubt?</label>
        <input type="checkbox" id="update-selMulti" disabled name="selMulti" />
        <form action="/role-select/update" method="POST" class="rol-sel-upd-btn-form">
          <input type="hidden" name="serverId" value="<%= selectedServerId %>" />
          <input type="hidden" id="update-selName" name="selName" required />
          <label for="update-selDesc">Text welcher in der Nachricht der Selfrole Auswahl steht</label>
          <input type="text" id="update-selDesc" name="selDesc" required />
          <br />
          <% rollen.forEach(function(role) { %>
          <br />
          <input id="update-role-<%= role.id %>" type="checkbox" name="roles" class="rl-sel-ckbx" value="<%= role.id %>">
          <label for="update-role-<%= role.id %>"><%= role.name %></label>
          <% }); %>
          <br />
          <button type="submit" id="rl-sel-submitUpdBtn" class="rl-sel-upd-btn" disabled>Update</button>
        </form>
      </div>
    </div>
  </div>
  <script>
    const allSelNames = JSON.parse(document.body.dataset.selNames || '[]');
    const allSelMenObj = JSON.parse(document.body.dataset.selMenObj || '[]');
    const selName = document.getElementById('selName');
    const submitAddBtn = document.getElementById('rl-sel-submitAddBtn');
    const errorMsg = document.getElementById('error-msg');
    const addBtn = document.getElementById('rl-sel-addBtn');
    const modal = document.getElementById('rl-sel-popUpModal');
    const checkboxes = document.querySelectorAll('.rl-sel-ckbx');
    const updateModal = document.getElementById('rl-sel-updatePopUpModal');
    const updateSelName = document.getElementById('update-selName');
    const updateSelDesc = document.getElementById('update-selDesc');
    const updateSelMulti = document.getElementById('update-selMulti');
    const updateCheckboxes = document.querySelectorAll('.rl-sel-ckbx');

    const updateButtons = document.querySelectorAll('.rol-sel-upd-btn');

    function validateForm() {
      const inputValue = selName.value.trim().toLowerCase();
      const nameExists = allSelNames.some(name => name.toLowerCase() === inputValue);
      if (nameExists) {
        errorMsg.style.display = 'block';
      } else {
        errorMsg.style.display = 'none';
      }
      const checkedCount = document.querySelectorAll('.rl-sel-ckbx:checked').length;
      const noCheckboxesChecked = checkedCount < 2;
      submitAddBtn.disabled = nameExists || noCheckboxesChecked;
    }

    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', validateForm);
    });
    selName.addEventListener('input', validateForm);
    addBtn.addEventListener('click', () => {
      modal.style.display = 'flex';
    });
    window.addEventListener('click', (event) => {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
      if (event.target === updateModal) {
        updateModal.style.display = 'none';
      }
    });
    validateForm();

    updateButtons.forEach(button => {
      button.addEventListener('click', (event) => {
        const name = event.target.getAttribute('data-name');
        const selMenObj = allSelMenObj.find(obj => obj.name === name);
        if (selMenObj) {
          document.getElementById('selMenObj-name').textContent = 'Name: ' + selMenObj.name;
          updateSelDesc.value = selMenObj.description;
          updateSelMulti.checked = selMenObj.multiSelect;
          updateCheckboxes.forEach(checkbox => {
            checkbox.checked = false;
          });
          selMenObj.roleIds.forEach(roleId => {
            const roleCheckbox = document.querySelector(`#update-role-${roleId}`);
            if (roleCheckbox) {
              roleCheckbox.checked = true;
            }
          });
          updateModal.style.display = 'flex';
        }
      });
    });

    function validateUpdateForm() {
      const checkedCount = document.querySelectorAll('.rl-sel-ckbx:checked').length;
      const noCheckboxesChecked = checkedCount < 2;
      document.getElementById('rl-sel-submitUpdBtn').disabled = noCheckboxesChecked;
    }

    updateCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('change', validateUpdateForm);
    });

    validateUpdateForm();
  </script>
</body>

</html>