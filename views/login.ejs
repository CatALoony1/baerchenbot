<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8" />
  <title>Login</title>
  <link rel="stylesheet" href="/css/style.css" />
  <!--Skript ausführen, welches überprüft was voreingestellt ist-->
  <%- include('partials/darkmode-script') %>
</head>

<body>
  <h1>Bitte anmelden</h1>
  <% if (typeof error !== 'undefined') { %>
  <p class="p-vis-err-mess">
    <strong><%= error %></strong>
  </p>
  <% } %>
  <form action="/login" method="POST">
    <label class="label-login" for="user">Nutzername:</label>
    <input class="input-login" type="text" id="user" name="user" required />
    <label class="label-login" for="password">Passwort:</label>
    <input class="input-login" type="password" id="password" name="password" required />
    <button class="btn-login" type="submit">Einloggen</button>
  </form>
</body>

</html>
