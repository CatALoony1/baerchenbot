<div id="giphyModal" class="giphy-modal">
  <div class="giphy-header">
    <input type="text" id="giphySearch" placeholder="In Giphy suchen..." oninput="debounceSearch()">
    <button type="button" class="giphy-close" onclick="closeGiphyModal()">&times;</button>
  </div>
  <div id="giphyGrid" onscroll="handleScroll()"></div>
</div>

<br /><br />
    <a href="/">Zurück zur Startseite</a>

<script>
  const GIPHY_API_KEY = '<%= giphyApiKey %>';
  let currentSearch = '';
  let debounceTimer;
  let currentOffset = 0;
  let isLoading = false;
  let hasMore = true;
  let activeInputId = null;
  let activePreviewId = null;

  function clearGif(inputId, previewId) {
  document.getElementById(inputId).value = '';
  document.getElementById(previewId).innerHTML = '';
}
  function openGiphyModal(inputId, previewId) {
    activeInputId = inputId;
    activePreviewId = previewId;
    const modal = document.getElementById('giphyModal');
    modal.classList.add('active');
    document.getElementById('giphySearch').value = '';
    currentSearch = '';
    currentOffset = 0;
    hasMore = true;
    document.getElementById('giphyGrid').innerHTML = '';
    
    fetchGifs();
  }

  function closeGiphyModal() {
    document.getElementById('giphyModal').classList.remove('active');
  }

  function debounceSearch() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentSearch = document.getElementById('giphySearch').value.trim();
      currentOffset = 0;
      hasMore = true;
      document.getElementById('giphyGrid').innerHTML = '';
      fetchGifs();
    }, 300);
  }

  async function fetchGifs() {
    if (isLoading || !hasMore) return;
    isLoading = true;
    const endpoint = currentSearch ? 'search' : 'trending';
    const queryParam = currentSearch ? `&q=${encodeURIComponent(currentSearch)}` : '';
    const url = `https://api.giphy.com/v1/gifs/${endpoint}?api_key=${GIPHY_API_KEY}&limit=20&offset=${currentOffset}${queryParam}`;
    try {
      const response = await fetch(url);
      const { data, pagination } = await response.json();
      if (!data || data.length === 0) {
        hasMore = false;
        if (currentOffset === 0) {
          document.getElementById('giphyGrid').innerHTML = '<p style="color: white; padding: 10px;">Keine GIFs gefunden.</p>';
        }
        return;
      }

      const grid = document.getElementById('giphyGrid');
      data.forEach(gif => {
        const img = document.createElement('img');
        img.src = gif.images.fixed_height_small.url;
        img.style.width = '48%';
        img.style.margin = '1%';
        img.style.borderRadius = '6px';
        img.style.cursor = 'pointer';
        img.style.objectFit = 'cover';
        img.onclick = () => selectGif(gif);
        grid.appendChild(img);
      });
      currentOffset += data.length;
      if (currentOffset >= pagination.total_count) {
        hasMore = false;
      }
    } catch (err) {
      console.error('Fehler beim Laden der GIFs:', err);
    } finally {
      isLoading = false;
    }
  }

  function handleScroll() {
    const grid = document.getElementById('giphyGrid');
    if (grid.scrollTop + grid.clientHeight >= grid.scrollHeight - 50) {
      fetchGifs();
    }
  }

  function selectGif(gif) {
    if (activeInputId) {
      document.getElementById(activeInputId).value = gif.id;
    }
    if (activePreviewId) {
      const preview = document.getElementById(activePreviewId);
      if (preview) {
        preview.innerHTML = `<img class="selected-gif-preview" src="https://media.giphy.com/media/${gif.id}/giphy.gif">`;
      }
    }
    closeGiphyModal();
  }
</script>
  </body>
</html>