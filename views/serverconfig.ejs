<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>Datenbank - Dashboard</title>
    <script src="https://unpkg.com/@giphy/js-fetch-api/dist/giphy-js-fetch-api.bundle.js"></script>
  <script src="https://unpkg.com/@giphy/js-components/dist/giphy-js-components.bundle.js"></script>
  
  <style>
.giphy-modal {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 450px;
    max-width: 90vw;
    height: 550px;
    background: #fff; /* ODER #121212, damit man den Hintergrund sieht */
    border: 1px solid #ccc;
    z-index: 1000;
    flex-direction: column;
  }

  .giphy-modal.active {
    display: flex;
  }

  #giphyGrid {
    flex: 1;
    overflow-y: auto;
  }
  </style>
  </head>
  <body>
    <h1>Server & Datenbank</h1>
    <% if (error) { %>
    <div class="error-box">
      <strong>Fehler:</strong>
      <%= error %>
    </div>
    <% } %>
<form action="/serverconfig" method="GET">
  <label for="serverId">Wähle einen Server:</label>
  <select name="serverId" id="serverId" onchange="this.form.submit()">
    <option value="" <%= !selectedServerId ? 'disabled' : '' %>>-- Bitte wählen --</option>
    <% servers.forEach(function(server, index) { %>
      <% 
        const isSelected = selectedServerId 
          ? server.id === selectedServerId 
          : index === 0; 
      %>
      <option value="<%= server.id %>" <%= isSelected ? 'selected' : '' %>>
        <%= server.name %>
      </option>
    <% }); %>
  </select>
</form>

    <br />
    <hr />
    <br />

    <% if (selectedServerId && alleRollen.length > 0 ) { %>
    <h2>Gefundene Einträge:</h2>
    <table border="1" cellpadding="5" style="border-collapse: collapse">
      <thead>
        <tr>
         <th>Nutzung</th>
          <th>Variable</th>
          <th>Kanal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= uses.MITGLIED_ROLE_ID %></td>
          <td>MITGLIED_ROLE_ID</td>
          <td>
            <form action="/serverconfig/change-member-role" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
              <input type="hidden" name="variableName" value="MITGLIED_ROLE_ID">
                <select name="newMemberRole" onchange="this.form.submit()">
                  <% alleRollen.forEach(function(role) { %>
                <option value="<%= role.id %>" <%= role.id === defaultRole[0] ? 'selected' : '' %>>
                    <%= role.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.NEWMEMBER_ROLE_ID %></td>
          <td>NEWMEMBER_ROLE_ID</td>
          <td>
            <form action="/serverconfig/change-member-role" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
              <input type="hidden" name="variableName" value="NEWMEMBER_ROLE_ID">
                <select name="newMemberRole" onchange="this.form.submit()">
                  <% alleRollen.forEach(function(role) { %>
                <option value="<%= role.id %>" <%= role.id === defaultRole[1] ? 'selected' : '' %>>
                    <%= role.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
          </tr>
          <tr>
          <td><%= uses.MIDMEMBER_ROLE_ID %></td>
          <td>MIDMEMBER_ROLE_ID</td>
          <td>
            <form action="/serverconfig/change-mmember-role" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
              <input type="hidden" name="variableName" value="MIDMEMBER_ROLE_ID">
                <select name="newMemberRole" onchange="this.form.submit()">
                  <% alleRollen.forEach(function(role) { %>
                <option value="<%= role.id %>" <%= role.id === defaultRole[2] ? 'selected' : '' %>>
                    <%= role.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    <% } %>
    <br />
    <hr />
    <br />
    <p>Den Text am besten in Discord schreiben und hier per Copy&Paste einfügen, damit Pings funktionieren.</p>
    <br />
    <p>Möchtest du den Nutzer pingen, welcher die Benachrichtigung ausgelöst hat, so setze bitte "-userping-" (ohne Anführungszeichen) an der gewünschten Stelle als Platzhalter ein. Dies wird Serverseitig durch den User ersetzt.</p>
    <br />
    <img src="/images/embed_example.png" alt="Beispielbild" class="selected-gif-preview">
    <br />
    <details>
