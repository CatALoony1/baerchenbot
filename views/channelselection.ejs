          <td>LOG_ID</td>
          <td>
            <form action="/channelselection/change-channel-log" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="log" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(channel) { %>
                <option value="<%= channel.id %>" <%= channel.id === defaultValues.LOG_ID ? 'selected' : '' %>>
                    <%= channel.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.BUMP_ID %></td>
          <td>BUMP_ID</td>
          <td>
            <form action="/channelselection/change-channel-bump" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="bump" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(channel) { %>
                <option value="<%= channel.id %>" <%= channel.id === defaultValues.BUMP_ID ? 'selected' : '' %>>
                    <%= channel.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.QUIZ_ID %></td>
          <td>QUIZ_ID</td>
          <td>
            <form action="/channelselection/change-channel-quiz" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
