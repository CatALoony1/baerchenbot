                    <%= channel.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.VCCREATION_ID %></td>
          <td>VCCREATION_ID</td>
          <td>
            <form action="/channelselection/change-channel-vccreation" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
