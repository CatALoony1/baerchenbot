                    <%= channel.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.ADMIN_C_ID %></td>
          <td>ADMIN_C_ID</td>
          <td>
            <form action="/channelselection/change-channel-admin" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
