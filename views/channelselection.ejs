              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="allgemein" onchange="this.form.submit()">
<% const hasSelectedValue1 = typeof defaultValues !== 'undefined' && defaultValues && defaultValues.ALLGEMEIN_ID; %>
    
    <option value="" disabled <%= !hasSelectedValue1 ? 'selected' : '' %> hidden>
      -- Bitte Channel auswählen --
    </option>

    <% alleTextChannels.forEach(function(channel) { %>
      <option value="<%= channel.id %>" <%= hasSelectedValue1 && channel.id === defaultValues.ALLGEMEIN_ID ? 'selected' : '' %>>
        <%= channel.name %>
      </option>
    <% }); %>
                </select>
            </form>
          </td>
        </tr>
