            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.AFK_ID %></td>
          <td>AFK_ID</td>
          <td>
            <form action="/channelselection/change-channel-afk" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="afk" onchange="this.form.submit()">
                  <% alleVoiceChannels.forEach(function(channel) { %>
                <option value="<%= channel.id %>" <%= channel.id === defaultValues.AFK_ID ? 'selected' : '' %>>
                    <%= channel.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    <% } %>

    <br /><br />
    <a href="/">Zurück zur Startseite</a>
  </body>
</html>
